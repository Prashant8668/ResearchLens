# Server Configuration
PORT=5000
JWT_SECRET=your_secure_secret_here

# NLP Microservice URL
NLP_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_URL=http://localhost:8000

# AI Provider Configuration ('groq', 'gemini', or 'openai')
AI_PROVIDER=groq

# Groq API Configuration (Primary Summary Provider)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Fallback / Alternative Provider)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Alternative Provider)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
